# Where the Next.js server reaches the Licetum admin API (server-side only).
ADMIN_API_URL=http://localhost:8002
# Where the Licetum check API is (server-side; used by the "Integration" and "Check" screens).
CHECK_API_URL=http://localhost:8001
# The same API as the services that call it reach it (shown in the code examples of the Integration tab).
CHECK_API_PUBLIC_URL=http://localhost:8001
# Public URL of this app. The identity provider sends the browser back to ${APP_BASE_URL}/auth/callback: register it as the
# redirect URI of the client below.
APP_BASE_URL=http://localhost:3000
# This app is the OpenID Connect client of the administrator sign-in (code flow with PKCE). The identity provider is the one the
# admin API trusts (ADMIN_AUTH__ISSUER, ADMIN_AUTH__JWKS_URL); the access token it issues to this client must be a JWT whose aud
# contains ADMIN_AUTH__AUDIENCE of the admin API.
# Where the browser is sent to sign in, and where this server exchanges the code and renews the tokens (they may differ: a
# Compose network name).
OIDC_AUTHORIZATION_URL=http://localhost:5556/dex/auth
OIDC_TOKEN_URL=http://localhost:5556/dex/token
OIDC_CLIENT_ID=licetum-local
# Leave it empty for a public client (PKCE alone).
OIDC_CLIENT_SECRET=licetum-local-secret
# Default: openid profile email offline_access (offline_access asks for the refresh token that keeps the session going).
# OIDC_SCOPE=
# Encrypts the session cookie: a random string of at least 32 characters (openssl rand -hex 32).
SESSION_SECRET=change-me-change-me-change-me-change-me
