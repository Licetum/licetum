{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/after-edit.sh\"",
            "timeout": 300,
            "statusMessage": "Checking edited files"
          }
        ]
      }
    ]
  }
}
